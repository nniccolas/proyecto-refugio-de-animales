@startuml
skinparam style strictuml
skinparam monochrome true
skinparam sequenceMessageAlign center
hide footbox

title Francisco Lencina, Nicolas Bruno y Alexis Gomez\nDiagrama de Secuencia de Sistema - Caso de uso: Registrar Nuevo Animal

actor ":Refugio" as R
participant ":Sistema" as S

R -> S : ingresarSeccionAnimales()
activate S
S --> R : «registro de animales al día»
deactivate S

R -> S : agregarNuevoAnimal()
activate S
S --> R : «formulario de datos del animal»
deactivate S

loop hasta que el alias no esté repetido
    R -> S : ingresarDatosAnimal(nombre, sexo, especie, alias)
    activate S
    alt alias disponible
        S --> R : «solicitud de número de corral»
    else else
        S --> R : «mensaje de error: alias en uso»
    end
    deactivate S
end

loop hasta que el corral sea correcto y tenga espacio
    R -> S : asignarCorral(alias, numeroCorral)
    activate S
    alt número inexistente o erróneo
        S --> R : «mensaje de error: corral incorrecto»
    else corral lleno
        S --> R : «mensaje de error: corral lleno»
    else else
        S --> R : «consulta si se añade a adoptables»
    end
    deactivate S
end

alt animal en condiciones de ser adoptado
    R -> S : marcarAdoptable(alias)
    activate S
    S --> R : «registro finalizado: pendiente de adopción\n+ sección de inicio»
    deactivate S
else else
    R -> S : marcarCondicionPendiente(alias)
    activate S
    S --> R : «registro finalizado: condición de adoptable pendiente\n+ sección de inicio»
    deactivate S
end
@enduml
