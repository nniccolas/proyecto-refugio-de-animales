@startuml
skinparam style strictuml
skinparam monochrome true
skinparam sequenceMessageAlign center
hide footbox

title Francisco Lencina, Nicolas Bruno y Alexis Gomez\nDiagrama de Secuencia de Sistema - Caso de uso: Registrar Corrales

actor ":Refugio" as R
participant ":Sistema" as S

R -> S : ingresarSeccionAnimales()
activate S
S --> R : «registro de animales al día»
deactivate S

R -> S : ingresarSeccionCorrales()
activate S
S --> R : «corrales, ocupación y cantidad de animales»
deactivate S

R -> S : agregarNuevoCorral()
activate S
alt no hay espacio para nuevos corrales
    S --> R : «mensaje de error + opción de borrar corrales»
else else
    S --> R : «ventana de registro de corrales»
    deactivate S

    loop hasta que el número no esté en uso
        R -> S : ingresarNumeroCorral(numeroCorral)
        activate S
        alt número disponible
            S --> R : «corral registrado + consulta si hay animales dentro»
        else else
            S --> R : «mensaje de error: número en uso»
        end
        deactivate S
    end

    alt no hay animales dentro
        R -> S : responderNegativo()
        activate S
        S --> R : «registro finalizado»
        deactivate S
    else else
        R -> S : responderAfirmativo(listaAlias)
        activate S
        S --> R : «animales añadidos al registro\ndel corral y de cada animal»
        deactivate S
    end
end
@enduml
